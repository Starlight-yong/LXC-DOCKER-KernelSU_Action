# 内核源码地址
KERNEL_SOURCE=https://github.com/juezhi6668/msm8998

# 内核源码分支
KERNEL_SOURCE_BRANCH=lineage-23.2

# 内核编译配置
KERNEL_CONFIG=sagit_defconfig

# 内核打包名字
KERNEL_ZIP_NAME=sagit_ksu_kernel

# 是否开启kvm
ENABLE_KVM=false

# 不要 docker/lxc
ENABLE_LXC_DOCKER=false

# 选择要打包的内核镜像文件
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否需要 LLVM=1 LLVM_IAS=1
LLVM_CONFIG=y

# 是否需要切换python2
SWITCH_PYTHON=false

# 是否需要dtbo
NEED_DTBO=false

# 只开启 KernelSU
ENABLE_KERNELSU=true
KERNELSU_TAG=main
